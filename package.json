{
  "name": "react-native-kustom-inapp-sdk",
  "title": "Kustom Mobile SDK React Native",
  "version": "1.0.4",
  "description": "This library wraps Kustom Mobile SDK and exposes its functionality as React Native components.",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "exports": {
    ".": {
      "react-native-kustom-inapp-sdk-source": "./src/index.tsx",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!ios/build",
    "!ios/Podfile",
    "!ios/Pods",
    "!ios/RNKustomMobileSDK.xcworkspace",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "prepack": "bob build",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,tsx}\" --fix",
    "prettier": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "prettier:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "clean": "del-cli android/build ios/build example/android/build example/android/app/build example/ios/build",
    "pods": "pod-install --quiet",
    "example": "yarn workspace react-native-kustom-inapp-sdk-example",
    "test:android": "cd example/android && ./gradlew :react-native-kustom-inapp-sdk:testDebugUnitTest && cd ../..",
    "test:ios": "cd ios && xcodebuild test -workspace RNKustomMobileSDK.xcworkspace -scheme RNKustomMobileSDK -sdk iphonesimulator -destination 'platform=iOS Simulator,name=iPhone 16'",
    "build:android": "cd example/android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd example/ios && xcodebuild -workspace KustomSDKExample.xcworkspace -scheme KustomSDKExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO"
  },
  "keywords": [
    "react-native",
    "kustom",
    "sdk"
  ],
  "repository": "https://github.com/Kustom-Checkout/react-native-kustom-inapp-sdk",
  "author": "Kustom App <kustom-app@kustom.co>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Kustom-Checkout/react-native-kustom-inapp-sdk#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "licenseFilename": "LICENSE",
  "readmeFilename": "README.md",
  "peerDependencies": {
    "react": ">=16.5.0",
    "react-native": ">=0.57.0 <1.0.x"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.72.2",
    "@types/jest": "^29.5.4",
    "@types/react": "^18.0.24",
    "@types/react-native": "^0.72.2",
    "@typescript-eslint/eslint-plugin": "^6.6.0",
    "@typescript-eslint/parser": "^6.6.0",
    "eslint": "^8.48.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.2.3",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.2.1",
    "metro-react-native-babel-preset": "0.76.8",
    "pod-install": "^0.1.0",
    "prettier": "^3.0.3",
    "react": "18.2.0",
    "react-native": "0.72.4",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "^5.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.4.0",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  },
  "codegenConfig": {
    "name": "RNKustomMobileSDK",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.kustom.mobile.sdk.reactnative"
    },
    "ios": {
      "componentProvider": {
        "RNKustomCheckoutView": "KustomCheckoutViewWrapper"
      }
    }
  }
}
